# Copy to .env, or let scripts/dev-setup create it with random secrets. Never commit .env.
LL_ENV=development                      # development | test | production
# The app's account: SELECT, INSERT, UPDATE, DELETE only (no DROP, ALTER, TRIGGER).
LL_DATABASE_URL=mysql+pymysql://APP_USER:PASSWORD@127.0.0.1:3306/ledgerline?charset=utf8mb4
# The account that runs migrations and owns the audit triggers. Required in production.
LL_MIGRATION_DATABASE_URL=mysql+pymysql://OWNER_USER:PASSWORD@127.0.0.1:3306/ledgerline?charset=utf8mb4
# Tests: the owner account (tests empty tables), and optionally the app account to prove its limits.
LL_TEST_DATABASE_URL=mysql+pymysql://OWNER_USER:PASSWORD@127.0.0.1:3306/ledgerline_test?charset=utf8mb4
LL_TEST_APP_DATABASE_URL=mysql+pymysql://APP_USER:PASSWORD@127.0.0.1:3306/ledgerline_test?charset=utf8mb4
LL_SECRET_KEY=                          # at least 32 characters: openssl rand -hex 32
LL_ALLOWED_HOSTS=localhost,127.0.0.1    # production: exact public host names, no wildcards
LL_ALLOWED_ORIGINS=http://localhost:5173  # production: https:// only, exact origins

# Email (C13). Development: Mailpit on 127.0.0.1:1025, read at http://127.0.0.1:8025.
LL_FIRM_NAME=Ledgerline                  # shown in emails
LL_INVOICE_PREFIX=INV                    # invoice numbers read INV/26-27/00001
LL_INVOICE_TERMS_DAYS=15                 # invoice due date: days after it is raised
LL_FIRM_GST_STATE=                       # your GSTIN's first two digits, e.g. 33; decides CGST+SGST or IGST
LL_EMAIL_FROM_ADDRESS=no-reply@ledgerline.example.com   # production: your real sending address
LL_EMAIL_FROM_NAME=Ledgerline
LL_SMTP_HOST=127.0.0.1
LL_SMTP_PORT=1025
LL_SMTP_SECURITY=none                    # production: starttls or tls (none only for a local relay)
# LL_SMTP_USERNAME=
# LL_SMTP_PASSWORD=
# Signs delivery reports posted to /api/email/events (see api/app/routers/email_events.py).
# LL_EMAIL_WEBHOOK_SECRET=               # openssl rand -hex 32; unset switches the endpoint off

# Client portal links (C14).
LL_PUBLIC_URL=http://localhost:5173      # where the web app is; links point here. Production: https://
LL_PORTAL_LINK_HOURS=72                  # how long a client link works (1 to 720)

# Documents (C16). Files are encrypted with this key before they are stored; keep it apart from
# the database and its backups. Production refuses to start without it.
# LL_STORAGE_KEY=                        # openssl rand -base64 32
# LL_STORAGE_DIR=/var/lib/ledgerline/storage   # default: .dev/storage in the repo
LL_MAX_UPLOAD_BYTES=20971520             # 20 MB
LL_CLAMD_ADDRESS=unix:/var/run/clamav/clamd.ctl

# Client alerts (C18): reminder spacing, and the India-time hours automatic emails go out.
LL_REMINDER_INTERVAL_DAYS=2
LL_ALERT_HOURS_START=9
LL_ALERT_HOURS_END=19
LL_WAITING_GRACE_DAYS=3                  # days after the first alert before "waiting on client"
LL_ESCALATION_DAYS_BEFORE=2              # days before the due date that empty cycles escalate
