# Sends due client alerts and reminders (BRD FR-AL-01, FR-AL-03). Started by
# ledgerline-alerts.timer every 15 minutes; sends only within LL_ALERT_HOURS_START..END (India
# time). Exits 1, with a CRITICAL log line, if any cycle failed; running it again is safe.
# Adjust paths and user to your install.
[Unit]
Description=Ledgerline client alerts and reminders
After=network-online.target mysql.service

[Service]
Type=oneshot
User=ledgerline
Group=ledgerline
WorkingDirectory=/opt/ledgerline/api
EnvironmentFile=/opt/ledgerline/.env
ExecStart=/opt/ledgerline/api/.venv/bin/python -m app.cli send-alerts
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
