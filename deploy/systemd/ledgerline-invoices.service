# Raises invoices due on each client's billing schedule (BRD FR-FE-02). Started daily by
# ledgerline-invoices.timer. Exits 1, with a CRITICAL log line, if any client failed; running it
# again is safe (one invoice per client per period). Adjust paths and user to your install.
[Unit]
OnFailure=ledgerline-notify@%n.service
Description=Ledgerline invoices on the billing schedule
After=network-online.target mysql.service

[Service]
Type=oneshot
User=ledgerline
Group=ledgerline
WorkingDirectory=/opt/ledgerline/api
EnvironmentFile=/opt/ledgerline/.env
ExecStart=/opt/ledgerline/api/.venv/bin/python -m app.cli raise-invoices
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
