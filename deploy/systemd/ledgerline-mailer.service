# The email send worker (BRD INT-01): sends queued email, retrying for 24 hours.
# Long-running; systemd restarts it if it stops. Safe to run more than one (each email is
# claimed by one worker only). Adjust paths and user to your install.
[Unit]
OnFailure=ledgerline-notify@%n.service
Description=Ledgerline email send worker
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=ledgerline
Group=ledgerline
WorkingDirectory=/opt/ledgerline/api
EnvironmentFile=/opt/ledgerline/.env
ExecStart=/opt/ledgerline/api/.venv/bin/python -m app.cli send-emails
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
