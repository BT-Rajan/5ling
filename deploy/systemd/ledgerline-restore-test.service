# Quarterly restore test (BRD NFR-AV-02): restores the newest backup into a scratch database,
# checks it, and appends the result to /var/backups/ledgerline/restore-tests.log. A failure
# alerts the technical owner. See scripts/restore-test.
[Unit]
OnFailure=ledgerline-notify@%n.service
Description=Ledgerline restore test
After=network-online.target mysql.service

[Service]
Type=oneshot
User=ledgerline
Group=ledgerline
WorkingDirectory=/opt/ledgerline
EnvironmentFile=/opt/ledgerline/.env
ExecStart=/opt/ledgerline/scripts/restore-test
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/ledgerline
ProtectHome=yes
PrivateTmp=yes
